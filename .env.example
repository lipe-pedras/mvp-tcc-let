# --- Database ---
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb
POSTGRES_DB=kb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://kb:kb@localhost:5432/kb
TEST_DATABASE_URL=postgresql+psycopg://kb:kb@localhost:5432/kb_test

# --- Auth ---
JWT_SECRET=change-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Models (filled in later phases) ---
# ollama (default, local) | openai (any OpenAI-compatible endpoint; sends data off the machine)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=4096
# Only used when LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
REFUSAL_THRESHOLD=0.3
TOP_K=5
RETRIEVAL_CANDIDATES=30
RERANK_TOP_N=15
GAP_MIN_OCCURRENCES=3

# Gap panel: minimum occurrences (K) to show a cluster, and cosine similarity to join one
GAP_SIMILARITY=0.60
